# ================================
# 环境变量配置示例
# 健身俱乐部综合管理系统
# ================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置值
# 3. .env 文件已被添加到 .gitignore，不会提交到版本控制

# -------- 数据库配置 --------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitness_club
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# -------- JWT 安全配置 --------
# 重要：生产环境必须修改为强随机密钥！
# 建议使用至少64字符的随机字符串
# 可以使用以下命令生成：
# Linux/Mac: openssl rand -base64 64 | tr -d '\n'
# 或者: head -c 64 /dev/urandom | base64 | tr -d '\n'
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-change-this-in-production

# JWT Token 过期时间（毫秒）
# 默认 24 小时 = 86400000 毫秒
JWT_EXPIRATION=86400000

# -------- 服务端口配置 --------
SERVER_PORT=8080
FRONTEND_PORT=8081

# -------- 日志配置 --------
# 可选值: debug, info, warn, error
LOG_LEVEL=info

# MyBatis 日志配置（生产环境建议关闭）
# 完全路径：org.apache.ibatis.logging.stdout.StdOutImpl
# 关闭日志：org.apache.ibatis.logging.nologging.NoLoggingImpl
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

# -------- Docker 环境配置 --------
# MySQL root 密码（Docker 环境使用）
MYSQL_ROOT_PASSWORD=your_secure_mysql_password

# 时区配置
TZ=Asia/Shanghai

# -------- 生产环境额外配置 --------
# 以下配置建议在生产环境中设置

# 是否启用 HTTPS（需要配置 Nginx SSL）
# ENABLE_HTTPS=true

# 允许的 CORS 源（多个用逗号分隔）
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# 请求频率限制
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CAPACITY=100
# RATE_LIMIT_REFILL_TOKENS=100
# RATE_LIMIT_REFILL_DURATION=60
